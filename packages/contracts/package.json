{
  "name": "@kernloop/contracts",
  "version": "0.1.5",
  "description": "Kernloop Layer 1 — the frozen five contracts (TaskContract, Brief, Verdict, Outcome, Manifest) as zod schemas with inferred TypeScript types (spec §4).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kernloop/kernloop.git",
    "directory": "packages/contracts"
  }
}
