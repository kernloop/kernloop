{
  "name": "@kernloop/cli",
  "version": "0.1.0",
  "description": "Kernloop composition root (spec §9): the `kernloop` CLI and MCP server. Assembles kernel + faculties over a per-repo overlay (spec §7) and exposes exactly the kernel eleven — run, status, brief, gate, recall, remember, distill, forge, manifest, audit, observe (spec §3.4). Workshop creations register under the workshop/* manifest namespace, never as tool #12.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kernloop": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@kernloop/contracts": "workspace:*",
    "@kernloop/docscan": "workspace:*",
    "@kernloop/faculty-compiler": "workspace:*",
    "@kernloop/faculty-gates": "workspace:*",
    "@kernloop/faculty-memory": "workspace:*",
    "@kernloop/faculty-models": "workspace:*",
    "@kernloop/faculty-observer": "workspace:*",
    "@kernloop/faculty-scrum": "workspace:*",
    "@kernloop/faculty-toolsmith": "workspace:*",
    "@kernloop/faculty-workforce": "workspace:*",
    "@kernloop/kernel": "workspace:*",
    "@kernloop/parsimony": "workspace:*",
    "@kernloop/tracker": "workspace:*",
    "@kernloop/workflows": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "better-sqlite3": "^12.11.1",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kernloop/kernloop.git",
    "directory": "packages/cli"
  }
}
