{
  "name": "@kernloop/cli",
  "version": "0.1.0",
  "description": "Kernloop composition root (spec §9): the `kernloop` CLI and MCP server. Assembles kernel + faculties over a per-repo overlay (spec §7) and exposes the nine P1 kernel tools — run, status, brief, gate, recall, remember, manifest, audit, observe (spec §3.4). distill and forge are P3; absent here by design, not stubbed.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kernloop": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@kernloop/contracts": "workspace:*",
    "@kernloop/faculty-compiler": "workspace:*",
    "@kernloop/faculty-gates": "workspace:*",
    "@kernloop/faculty-memory": "workspace:*",
    "@kernloop/kernel": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.11"
  }
}
