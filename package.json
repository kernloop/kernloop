{
  "name": "kernloop-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=4 && vitest run --coverage --config vitest.root.config.mjs",
    "e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "evals": "vitest run --config packages/cli/vitest.evals.config.ts",
    "lint": "eslint . --max-warnings 0 && node scripts/loc-check.mjs",
    "wiring:check": "node scripts/wiring-check.mjs",
    "claims:check": "tsx claims/src/check.ts",
    "claims:render": "node scripts/render-claims.mjs",
    "claims:verify-ran": "node scripts/verify-claim-tests.mjs",
    "parsimony:render": "node scripts/render-parsimony-rule.mjs",
    "docs:render": "tsx scripts/render-api-docs.mjs",
    "docs:coverage": "tsx scripts/docs-coverage.mjs",
    "stats": "tsx scripts/stats.mjs",
    "stats:check": "tsx scripts/stats.mjs --check",
    "governance:check": "node scripts/governance-check.mjs",
    "vote-parity": "node scripts/vote-parity-check.mjs",
    "preflight": "pnpm build && pnpm typecheck && pnpm lint && pnpm wiring:check && pnpm format && pnpm test && pnpm claims:check && pnpm claims:verify-ran && node scripts/render-claims.mjs --check && pnpm docs:render -- --check && pnpm docs:coverage && pnpm stats:check && pnpm parsimony:render -- --check && pnpm governance:check && pnpm audit:selftest && pnpm e2e && pnpm evals",
    "preflight:check": "node scripts/check-preflight-sync.mjs",
    "audit:selftest": "node scripts/audit-selftest.mjs",
    "adapters:smoke": "node scripts/adapter-smoke.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@kernloop/faculty-workforce": "workspace:*",
    "@kernloop/kernel": "workspace:*",
    "@kernloop/parsimony": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "turbo": "^2.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1"
    }
  }
}
