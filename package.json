{
  "name": "kernloop-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --coverage --config vitest.root.config.mjs",
    "lint": "eslint . --max-warnings 0 && node scripts/loc-check.mjs",
    "wiring:check": "node scripts/wiring-check.mjs",
    "claims:check": "tsx claims/src/check.ts",
    "claims:render": "node scripts/render-claims.mjs",
    "claims:verify-ran": "node scripts/verify-claim-tests.mjs",
    "docs:render": "tsx scripts/render-api-docs.mjs",
    "docs:coverage": "tsx scripts/docs-coverage.mjs",
    "governance:check": "node scripts/governance-check.mjs",
    "audit:selftest": "node scripts/audit-selftest.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@kernloop/faculty-workforce": "workspace:*",
    "@kernloop/kernel": "workspace:*",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "turbo": "^2.9.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  }
}
